# Set these as hosted runtime values. Never commit .env or a token.
# Connected Shopify admin store: nr9zd0-t5.myshopify.com
# Configure both values together; a partial connection intentionally fails closed.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
SHOPIFY_API_VERSION=2026-07

# Independent IQON Supplements affiliate portal. Never reuse the Health database.
SUPPLEMENTS_DATABASE_URL=
SUPPLEMENTS_SITE_URL=
SUPPLEMENTS_AFFILIATE_BANK_ENCRYPTION_KEY=

# Admin app installed ONLY on nr9zd0-t5.myshopify.com (not a Storefront token).
SUPPLEMENTS_SHOPIFY_STORE_DOMAIN=nr9zd0-t5.myshopify.com
SUPPLEMENTS_SHOPIFY_ADMIN_TOKEN=
SUPPLEMENTS_SHOPIFY_WEBHOOK_SECRET=

# Supplements transactional email and optional admin notification recipient.
SUPPLEMENTS_RESEND_API_KEY=
SUPPLEMENTS_AFFILIATE_EMAIL_FROM=
SUPPLEMENTS_AFFILIATE_ADMIN_NOTIFY_EMAIL=
SUPPLEMENTS_EMAIL_FROM=
SUPPLEMENTS_CONTACT_REPLY_TO=

# Set both values to the same new random secret; Vercel sends CRON_SECRET.
SUPPLEMENTS_CRON_SECRET=
CRON_SECRET=

# Run bootstrap once from a trusted terminal; do not retain the password in hosting.
SUPPLEMENTS_ADMIN_EMAIL=
SUPPLEMENTS_ADMIN_PASSWORD=
# Optional ISO timestamp. Defaults to bootstrap time; excludes earlier purchases.
SUPPLEMENTS_AFFILIATE_START_AT=

# Optional personal welcome offer. Disabled until its business terms are approved.
SUPPLEMENTS_WELCOME_DISCOUNT_PERCENT=0

# Optional independent supplements mobile app. No Health project is inherited.
SUPPLEMENTS_APP_SUPABASE_URL=
SUPPLEMENTS_APP_SUPABASE_SERVICE_ROLE_KEY=
SUPPLEMENTS_REVENUECAT_SECRET_API_KEY=
SUPPLEMENTS_REVENUECAT_PROJECT_ID=

# P&L estimate only; set this to the supplements business’s actual average.
SUPPLEMENTS_ESTIMATED_SHIPPING_COST_PER_ORDER=6
