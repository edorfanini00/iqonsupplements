# Branded storefront runtime. Never commit .env files or credentials.
# Shopify Storefront credentials remain scoped to the supplements/skincare shop.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
SHOPIFY_API_VERSION=2026-07

# Public storefront pixel; honors GPC and excludes account/affiliate portals.
NEXT_PUBLIC_META_PIXEL_ID=1006368245818889

# Shared affiliate program: Health is the only identity and financial authority.
# Target production authorities: https://www.iqonhealth.com and https://www.iqondaily.com.
# Leave unset until the canonical backend has passed migration/release gates.
# Use separate explicitly configured staging origins/secrets for previews.
SHARED_AFFILIATE_HEALTH_ORIGIN=
SHARED_AFFILIATE_PORTAL_ORIGIN=
SHARED_AFFILIATE_RELAY_SECRET=

# Do NOT provision an independent affiliate DB, bootstrap account, bank key,
# supplements app project or duplicate affiliate jobs on this portal.
# The dormant Shopify adapter supports the same production-only renewal pair.
# It does not authorize independent ingestion, jobs, discounts or webhook writes.
SUPPLEMENTS_SHOPIFY_STORE_DOMAIN=nr9zd0-t5.myshopify.com
SUPPLEMENTS_SHOPIFY_CLIENT_ID=
SUPPLEMENTS_SHOPIFY_CLIENT_SECRET=
# Canonical webhooks and email remain ONLY on Health. See docs/affiliates.md.

# IQON Daily customer accounts (Shopify Customer Account API, existing Headless storefront,
# public client + PKCE). Shopify is the only customer identity; no password store here.
# See docs/customer-accounts.md. Leave all unset to show "accounts are opening soon".
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
SHOPIFY_CUSTOMER_ACCOUNT_SHOP_ID=
# >= 32 random bytes, base64. Dedicated to customer sessions; rotating it signs everyone out.
CUSTOMER_ACCOUNT_SESSION_SECRET=
# Only change after Shopify allowlists are verified; see docs/domain-migration.md.
# Exact public origin, e.g. https://www.iqondaily.com (redirect/logout URIs derive from it).
CUSTOMER_ACCOUNT_PUBLIC_ORIGIN=
SHOPIFY_CUSTOMER_ACCOUNT_API_VERSION=
# Only after the Shopify Subscriptions management page is published in customer accounts.
SHOPIFY_SUBSCRIPTION_MANAGEMENT_PUBLISHED=
SHOPIFY_SUBSCRIPTION_MANAGEMENT_URL=
