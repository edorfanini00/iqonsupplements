        "canonical": "import { nativeMutationFetch } from \"@/lib/affiliates/native-mutation-fetch\";\n"
      },
      {
        "original": "export default function ContactAffiliateTeam(){const [status,setStatus]=useState('');const [busy,setBusy]=useState(false);return <main id=\"main\" className=\"max-w-xl mx-auto px-6 py-20\"><p className=\"eyebrow mb-4\">IQON PARTNERS</p><h1 className=\"text-4xl mb-5\">Let\u2019s stay connected.</h1><p className=\"text-slate-500 mb-8\">Questions about your application or affiliate program? Leave a message for the supplements team.</p><form className=\"space-y-5\" onSubmit={async e=>{e.preventDefault();const form=e.currentTarget;setBusy(true);setStatus('');try{const body=Object.fromEntries(new FormData(form));const r=await fetch('/api/affiliates/contact',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});const d=await r.json();if(!r.ok)throw new Error(d.error);setStatus('Message received. Our team will reply by email.');form.reset();}catch(err){setStatus(err instanceof Error?err.message:'Your message could not be sent.');}finally{setBusy(false);}}}><label className=\"block text-sm\">Name<input name=\"name\" required maxLength={120} className=\"block border rounded p-3 mt-2 w-full\" autoComplete=\"name\"/></label><label className=\"block text-sm\">Email<input name=\"email\" type=\"email\" required maxLength={254} className=\"block border rounded p-3 mt-2 w-full\" autoComplete=\"email\"/></label><label className=\"block text-sm\">Subject<input name=\"subject\" maxLength={160} className=\"block border rounded p-3 mt-2 w-full\"/></label><label className=\"block text-sm\">Message<textarea name=\"message\" required minLength={10} maxLength={5000} rows={5} className=\"block border rounded p-3 mt-2 w-full\"/></label><input name=\"companyWebsite\" className=\"hidden\" tabIndex={-1} autoComplete=\"off\" aria-hidden=\"true\"/><button className=\"button button-dark\" disabled={busy}>{busy?'Sending\u2026':'Send message'}</button>{status&&<p role=\"status\" className=\"text-sm text-slate-600\">{status}</p>}</form></main>;}\n",
        "canonical": "export default function ContactAffiliateTeam(){const [status,setStatus]=useState('');const [busy,setBusy]=useState(false);return <main id=\"main\" className=\"max-w-xl mx-auto px-6 py-20\"><p className=\"eyebrow mb-4\">IQON PARTNERS</p><h1 className=\"text-4xl mb-5\">Let\u2019s stay connected.</h1><p className=\"text-slate-500 mb-8\">Questions about your application or affiliate program? Leave a message for the supplements team.</p><form className=\"space-y-5\" onSubmit={async e=>{e.preventDefault();const form=e.currentTarget;setBusy(true);setStatus('');try{const body=Object.fromEntries(new FormData(form));const r=await nativeMutationFetch('/api/affiliates/contact',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});const d=await r.json();if(!r.ok)throw new Error(d.error);setStatus('Message received. Our team will reply by email.');form.reset();}catch(err){setStatus(err instanceof Error?err.message:'Your message could not be sent.');}finally{setBusy(false);}}}><label className=\"block text-sm\">Name<input name=\"name\" required maxLength={120} className=\"block border rounded p-3 mt-2 w-full\" autoComplete=\"name\"/></label><label className=\"block text-sm\">Email<input name=\"email\" type=\"email\" required maxLength={254} className=\"block border rounded p-3 mt-2 w-full\" autoComplete=\"email\"/></label><label className=\"block text-sm\">Subject<input name=\"subject\" maxLength={160} className=\"block border rounded p-3 mt-2 w-full\"/></label><label className=\"block text-sm\">Message<textarea name=\"message\" required minLength={10} maxLength={5000} rows={5} className=\"block border rounded p-3 mt-2 w-full\"/></label><input name=\"companyWebsite\" className=\"hidden\" tabIndex={-1} autoComplete=\"off\" aria-hidden=\"true\"/><button className=\"button button-dark\" disabled={busy}>{busy?'Sending\u2026':'Send message'}</button>{status&&<p role=\"status\" className=\"text-sm text-slate-600\">{status}</p>}</form></main>;}\n"
      }
    ]
